# ==============================================================================
# TruthLens Environment Configuration Template
# Copy this file to .env and supply your production credentials
# ==============================================================================

# Server Environment (development | production)
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
DEBUG=false

# PostgreSQL Database Connection URL
# On Render: Use the 'Internal Database URL' from your Render PostgreSQL instance
# Format: postgresql+psycopg://username:password@hostname:5432/dbname
DATABASE_URL=sqlite:///truthlens.db

# Dynamic External Verification APIs (Server-Side Only - Never Exposed to Frontend)
# 1. Tavily Search API (Get free key at https://tavily.com)
TAVILY_API_KEY=

# 2. Google Fact Check Tools API (Get free key from Google Cloud Console -> Fact Check Tools API)
GOOGLE_FACT_CHECK_API_KEY=

# 3. Groq API for LLaMA 3.3 Fast Inference (Get free key at https://console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Allowed CORS Origins (Comma-separated for Vercel/Netlify frontend domains)
# Example: https://truthlens.vercel.app,http://localhost:3000,http://localhost:5173
CORS_ORIGINS=*
